{
    "name": "url-shortener",
    "version": "1.0.0",
    "description": "A lightweight and self-hosted URL shortener",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc && tsc-alias -p tsconfig.json --resolve-full-paths --resolve-full-extension .js",
        "start": "node dist/index.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/KauaOnoratoDev/url-shortener.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/KauaOnoratoDev/url-shortener/issues"
    },
    "homepage": "https://github.com/KauaOnoratoDev/url-shortener#readme",
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@swc/core": "^1.15.46",
        "@swc/jest": "^0.2.39",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.1.1",
        "@types/pg": "^8.20.0",
        "dotenv": "^17.4.2",
        "drizzle-kit": "^1.0.0-rc.4",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "lint-staged": "^17.0.8",
        "prettier": "^3.9.5",
        "tsc-alias": "^1.9.1",
        "tsx": "^4.23.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.64.0"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "argon2": "^0.45.1",
        "cors": "^2.8.6",
        "drizzle-orm": "^1.0.0-rc.4",
        "express": "^5.2.1",
        "hashids": "^2.3.0",
        "jsonwebtoken": "^9.0.3",
        "ms": "^2.1.3",
        "pg": "^8.22.0",
        "uuidv7": "^1.2.1",
        "zod": "^4.4.3"
    }
}
